# RunGrid Environment Configuration Example
# Copy this file to .env for local deployment

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rungrid
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rungrid

# Security & Authentication Settings
SECRET_KEY=super-secret-key-change-in-production-32bytes
JWT_SECRET=super-secret-key-change-in-production-32bytes

# Internal API Worker Authentication Key
INTERNAL_API_KEY=internal-worker-secret-key

# Service URLs
PROMETHEUS_URL=http://localhost:9090
VITE_API_URL=http://localhost:8000
